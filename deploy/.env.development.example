# Development deploy configuration.
# Copy to .env.development and fill in local/dev-only values.

NOTEBOOKLM_DEPLOY_ENV=development

# MCP bearer token for Claude Code/Desktop clients.
# Dev can use a short local-only value, but do not reuse it in production.
NOTEBOOKLM_MCP_TOKEN=dev-change-me
NOTEBOOKLM_MCP_MANAGED_KEYS_ENABLED=1
NOTEBOOKLM_MCP_DAILY_CREATE_LIMIT=100

# Private single-user dev only. Leave unset unless the endpoint is already
# protected by another local access layer.
# NOTEBOOKLM_MCP_AUTH_BYPASS=1

# Optional OAuth for claude.ai testing. Set both together when needed.
# NOTEBOOKLM_MCP_OAUTH_PASSWORD=dev-change-me-at-least-16-chars
# NOTEBOOKLM_MCP_OAUTH_BASE_URL=https://dev-notebooklm.example.com

# REST API token used by deploy/docker-compose.web.yml.
NOTEBOOKLM_SERVER_TOKEN=dev-change-me

# Shared secret for remote cookie sync routes.
NOTEBOOKLM_COOKIE_SYNC_TOKEN=dev-change-me
NOTEBOOKLM_DASHBOARD_PASSWORD=123
NOTEBOOKLM_DASHBOARD_SESSION_SECRET=dev-dashboard-session-change-me

# Pick one tunnel when running `make dev`.
# Cloudflare is the default tunnel profile.
CF_TUNNEL_TOKEN=

# Tailscale: run `make dev TUNNEL=tailscale`.
# TS_AUTHKEY=tskey-auth-xxxxxxxx

# Use a development NotebookLM profile/account so local experiments do not
# share cookies or notebooks with production.
# NOTEBOOKLM_PROFILE_DIR=/Users/you/.notebooklm/profiles/development

# External reverse-proxy network used by docker-compose.web.yml / vps override.
NOTEBOOKLM_PROXY_NETWORK=mtips5s_match_app-network-mtips5s
