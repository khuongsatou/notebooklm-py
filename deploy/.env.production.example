# Production deploy configuration.
# Copy to .env.production and fill in real production secrets.

NOTEBOOKLM_DEPLOY_ENV=production

# Generate strong random values, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTEBOOKLM_MCP_TOKEN=
NOTEBOOKLM_MCP_MANAGED_KEYS_ENABLED=1
NOTEBOOKLM_MCP_DAILY_CREATE_LIMIT=100
NOTEBOOKLM_SERVER_TOKEN=
NOTEBOOKLM_COOKIE_SYNC_TOKEN=

# Browser dashboard login. Change the password immediately on public deployments.
NOTEBOOKLM_DASHBOARD_PASSWORD=123
NOTEBOOKLM_DASHBOARD_SESSION_SECRET=

# Do not enable NOTEBOOKLM_MCP_AUTH_BYPASS in production.

# Optional OAuth for claude.ai. Set both together; BASE_URL must be the bare
# public https origin, not the /mcp connector URL.
# NOTEBOOKLM_MCP_OAUTH_PASSWORD=
# NOTEBOOKLM_MCP_OAUTH_BASE_URL=https://notebooklm.example.com

# Pick one tunnel when running `make prod`.
# Cloudflare is the default tunnel profile.
CF_TUNNEL_TOKEN=
# Optional: pin the tunnel connector for reproducible production redeploys.
# CLOUDFLARED_VERSION=2026.7.0

# Tailscale: run `make prod TUNNEL=tailscale VERSION=x.y.z`.
# TS_AUTHKEY=tskey-auth-xxxxxxxx

# Use a dedicated/throwaway production NotebookLM profile/account. The mounted
# profile can contain master_token.json, storage_state.json, and oauth_state.json.
# NOTEBOOKLM_PROFILE_DIR=/home/notebooklm/.notebooklm/profiles/production

# External reverse-proxy network used by docker-compose.web.yml / vps override.
NOTEBOOKLM_PROXY_NETWORK=mtips5s_match_app-network-mtips5s
