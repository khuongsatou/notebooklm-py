# Development renderer configuration.
# Copy to .env.development for browser-only development.

VITE_NOTEBOOKLM_ENV=development

# Browser-rendered Vite dev server requests use this REST API base. Electron
# desktop runs normally go through the preload bridge and do not require it.
VITE_NOTEBOOKLM_API_BASE=http://127.0.0.1:8000
